+  if (format === 'raw') return 'privatemode ?';
+  const login = (smsLogin || '').trim();
+  const password = (smsPassword || '').trim();
+  const auth = [login, password].filter(Boolean).join(' ');
+  return auth ? `@sms_dbg:${auth} privatemode ?` : '@sms_dbg:privatemode ?';
