+        try:
+            return next(self._it)
+        except StopIteration:
+            raise StopAsyncIteration
+
+
+class _Coll:
+    """Fake collection qui SIMULE l'index unique partiel {state:OPEN} sur
+    (tenant_id, vehicle_id, tracker_id) : insert d'une 2e OPEN -> DuplicateKeyError."""
+    def __init__(self):
+        self.docs = []
+
