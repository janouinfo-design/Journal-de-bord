{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fleet-trips-4.preview.emergentagent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fleet-trips-4.preview.emergentagent.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://journal.logitrak.ch"
      }
    },
    "pilot-production": {
      "distribution": "internal",
      "channel": "pilot-private-mode",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://journal.logitrak.ch"
      }
    },
    "pilot-dev-ble": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "pilot-dev-ble",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://journal.logitrak.ch",
        "EXPO_PUBLIC_PRIVATE_MODE_BLE_DEV": "1",
        "EXPO_PUBLIC_BLE_DEV_ALLOWED_TRACKERS": "781479"
      }
    },
    "pilot-ble-apk": {
      "distribution": "internal",
      "channel": "pilot-ble-apk",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://journal.logitrak.ch",
        "EXPO_PUBLIC_PRIVATE_MODE_BLE_DEV": "1",
        "EXPO_PUBLIC_BLE_DEV_ALLOWED_TRACKERS": "781479"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "ops@logitrak.ch",
        "ascAppId": "0000000000",
        "appleTeamId": "AAAAAAAAAA"
      },
      "android": {
        "serviceAccountKeyPath": "./play-store-service-account.json",
        "track": "internal"
      }
    }
  }
}
